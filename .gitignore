__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Node / frontend build output ---
node_modules/

# --- Local dataset / cache artifacts (large, regenerated locally) ---
