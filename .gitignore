# --- Python virtual environments (created locally per README setup) ---
.venv/
venv/
venv311/
env/

# --- Python caches / build artifacts ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
# Bare `dist/` — matches setuptools output AND the frontend esbuild bundle dir.
# That double duty is intentional but easy to miss; see the Node section below.
dist/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Node / frontend build output ---
node_modules/
# NOTE: the esbuild bundle (apps/dev-host/.../static/dist/) is covered by the
# bare `dist/` rule above and is deliberately NOT committed. `main` ships the
# raw-source entry (`npm run build:dev`), which is what the launcher serves;
# the bundle exists only as the gate-6 build proof and for the `release` branch.
# tools/check_entry.mjs fails the gate if urdf.html ever points at an untracked
# file again (see the ARQ-1 finding in docs/evaluacion-calidad-software.md).

# --- Local dataset / cache artifacts (large, regenerated locally) ---
**/projects/avisualizer/database/
apps/dev-host/database/
**/*.cache.npz
Sensors.csv

# --- Secrets & local env (never commit real values) ---
.env
*.env
!*.env.example

# --- Claude Code per-user local settings (machine-specific, not shared) ---
.claude/settings.local.json

# --- Editor / OS / tooling noise ---
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
.playwright-mcp/

# --- Launcher's dedicated browser profile (if ever created here) ---
MeltioViewer/

# Raw mesh sources / heavy media not needed at runtime (URDF uses .glb)
**/assets/*/OBJ_Files/
**/seed_data/
*.mp4

# Default output of tools/gen_shell.mjs when run without --out. The shell is
# assembled at release time, never committed: a second copy of urdf.html in the
# repo is a copy that drifts.
/shell/
