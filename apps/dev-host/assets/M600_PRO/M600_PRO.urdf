<?xml version="1.0"?>
<robot name="M600_PRO">

  <!-- ===================== LINKS ===================== -->

  <!-- Base / anchor component -->
  <link name="chassis_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 3.141592653589793 0"/>
      <geometry>
        <mesh filename="Chassis.glb" scale="0.001 0.001 0.001"/>
