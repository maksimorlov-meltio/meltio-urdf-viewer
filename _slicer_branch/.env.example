# Copy this file to `.env` (which is git-ignored) and adjust as needed.
# docker compose reads it automatically.

# GHCR owner for the image names: ghcr.io/<IMAGE_OWNER>/{orbit,aslicer}
IMAGE_OWNER=machine-software

# Image tag to run. Locally you build :latest; CI will push :<git-sha> tags.
TAG=latest

# --- Server only (docker-compose.prod.yml) ---
# Cloudflare Tunnel token from the Zero Trust dashboard. Leave blank locally.
TUNNEL_TOKEN=

# --- Platform service ---
# Bundled Postgres credentials (also used to build the default DATABASE_URL).
POSTGRES_USER=meltio
POSTGRES_PASSWORD=meltio
POSTGRES_DB=meltio
# Override to point the platform at an external DB (e.g. RDS) in the cloud.
# PLATFORM_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/meltio
#
# Local dev only: with no Cloudflare Access in front, fake the signed-in user so
# /api/me works. Leave blank on the server (the SSO header supplies identity).
PLATFORM_DEV_USER_EMAIL=dev@meltio3d.com
#
# Comma-separated emails auto-granted the superuser role on sign-in (bootstrap
# the first admin; superusers see all orgs' work and can manage roles).
PLATFORM_SUPERUSER_EMAILS=
#
# Object store. Defaults target the bundled MinIO; point at real S3 in cloud.
PLATFORM_S3_ENDPOINT_URL=http://minio:9000
PLATFORM_S3_REGION=eu-north-1
PLATFORM_S3_BUCKET=meltio-platform
PLATFORM_S3_ACCESS_KEY=minioadmin
PLATFORM_S3_SECRET_KEY=minioadmin
